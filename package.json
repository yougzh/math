{
  "name": "math-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:content",
    "dev": "next dev -p 3000",
    "prebuild": "npm run build:content",
    "build": "next build",
    "start": "next start -p 3000",
    "build:content": "tsx scripts/build-content.ts",
    "check:content": "tsx scripts/check-content.ts",
    "stats:content": "tsx scripts/check-content.ts --stats",
    "audit:stories": "tsx scripts/audit-stories.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu22.04-x64 playwright test",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx scripts/db-local.ts init",
    "db:start": "tsx scripts/db-local.ts start",
    "db:stop": "tsx scripts/db-local.ts stop",
    "db:reset": "tsx scripts/db-local.ts reset",
    "db:status": "tsx scripts/db-local.ts status",
    "db:import": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.3.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  }
}